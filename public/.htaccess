# Conta Comigo — configuração para Apache (HostGator / cPanel)

# 1) Sempre em HTTPS (necessário para instalar como app e para a voz)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2) Tipos de arquivo
AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddType text/javascript .js

# 3) Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# 4) Cache: JS/CSS têm hash no nome (1 ano); imagens 30 dias; páginas sempre revalidam
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "(\.html|\.webmanifest|^sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Não listar o conteúdo das pastas
Options -Indexes
DirectoryIndex index.html
